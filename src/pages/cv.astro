---
import { getEntry, render } from "astro:content";
import Markdown from "@components/misc/Markdown.astro";
import MainGridLayout from "@layouts/MainGridLayout.astro";
const cv = await getEntry("spec", "cv");
if (!cv) throw new Error("Missing CV content");
const { Content } = await render(cv);
---
<MainGridLayout title="CV"><article class="card-base p-6 md:p-9" data-pagefind-body><h1 data-pagefind-meta="title" class="text-4xl font-bold text-90 mb-6">CV</h1><Markdown><Content /></Markdown></article></MainGridLayout>
