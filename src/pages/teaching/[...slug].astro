---
import { getCollection } from "astro:content";
import ResourceDetail from "@components/ResourceDetail.astro";
export async function getStaticPaths() {
  return (await getCollection("notes")).map(entry => ({
    params: { slug: entry.data.permalink.replace("/teaching/", "") }, props: { entry }
  }));
}
const { entry } = Astro.props;
---
<ResourceDetail entry={entry} />
